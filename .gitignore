# Mixed-access PK/hERG research workspaces contain internal-source derivatives.
# Public platform releases are built separately under research/*/platform/.
/research/data/pk_herg/
/research/models/pk_herg/
/research/reports/pk_herg/
/research/simulations/
/research/outputs/
/outputs/

# Local atomic-build and scratch workspaces.
/.tmp/

# Rights-pending source copies are inventory-only and never part of the public
# platform release. Their original source bytes remain in the legacy archive.
/research/data/platform/raw/local_legacy/bindingdb/
/research/data/platform/raw/local_legacy/pubchem/
/research/data/platform/raw/sun_2026/
/research/data/platform/raw/restricted/

# Reproducible ChEMBL bulk cache: keep small manifests/configs in Git, not the
# multi-gigabyte archive, extracted database, or partitioned fact tables.
/research/data/platform/raw/chembl_37_bulk/*.tar.gz
/research/data/platform/raw/chembl_37_bulk/extracted/*.db
/research/data/platform/raw/chembl_37_bulk/extracted/.chembl_37.db.*
/research/data/platform/interim/chembl_37_bulk/activity_facts/
/research/data/platform/interim/chembl_37_bulk/specialized_views/**/*.parquet
/research/data/platform/interim/chembl_37_bulk/**/*_checkpoint.json

# Dated external-source payload bytes live in governed content-addressed
# storage. Keep their small manifests, request metadata, checksums, and README
# evidence visible to Git while excluding the reproducible heavy payloads.
/research/data/platform/raw/external_public/**/*.zip
/research/data/platform/raw/external_public/**/*.bin
/research/data/platform/raw/external_public/**/*.fasta
/research/data/platform/raw/external_public/**/*.xml
/research/data/platform/raw/external_public/**/*.jsonl
/research/data/platform/raw/external_public/**/pages/page_[0-9][0-9][0-9][0-9][0-9][0-9].json
/research/data/platform/raw/external_public/**/metadata_history/version_probe_[0-9][0-9][0-9][0-9][0-9][0-9].json
/research/data/platform/interim/external_public_normalized/**/*.parquet

# Failed canonical stages are retained locally for audit but their large data
# payloads and registries must never enter normal Git history. README evidence
# remains versionable.
/research/data/platform/quarantine/**/*.parquet
/research/data/platform/quarantine/**/*.sqlite*
/research/data/platform/canonical/.*.building/

# Large regenerated platform derivatives are intended for separately governed,
# content-addressed artifact storage and are not currently published or kept in
# normal Git history. Keep small registries, dictionaries, reports, and JSON
# manifests versionable.
/research/data/platform/canonical/**/*.parquet
/research/data/platform/qc/**/*.parquet
/research/data/platform/features/**/*.parquet
/research/data/platform/splits/**/*.csv
/research/data/platform/splits/**/*.parquet
/research/data/platform/model_ready/**/*.jsonl
/research/data/platform/model_ready/**/*.parquet

